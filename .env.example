# Copy to .env and fill in. NOTHING here is required to start the server.
#
# There is no ANTHROPIC_API_KEY: Claude runs only through the logged-in `claude` CLI, on your
# own Claude subscription. Install it and run `claude` once to log in:
#   https://docs.claude.com/en/docs/claude-code/overview
# Consequence: the pipeline only runs on a machine with a CLI login. A HOSTED copy can serve and
# publish a map you computed locally, but cannot run one itself — that's the intended workflow
# (run locally -> save JSON -> publish).

# Fallback model + effort. The UI picks a quality preset per run (test=Haiku, standard=Sonnet,
# best=Fable 5 — see QUALITY_PRESETS in server/src/domain/request.ts); these values apply only to
# legacy requests without a preset, and ANTHROPIC_MODEL doubles as the Stage-0 normalize
# default. NOTE: Haiku 4.5 does not support the effort parameter — the server omits it for
# Haiku automatically.
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_EFFORT=low

# Optional: run Stage-0 title cleanup on a stronger model (e.g. claude-sonnet-5). One cheap call
# per CSV import. Defaults to ANTHROPIC_MODEL — Haiku already classifies book vs. non-book well.
NORMALIZE_MODEL=

# The constraint-filter judgment call (post-verification rule enforcement). Defaults to Sonnet:
# Haiku misapplies rules (invented length limits, same-title confusions), and the call is ~1k
# tokens (~$0.005/run). Set to claude-haiku-4-5 to pinch pennies at the cost of misfires.
FILTER_MODEL=

# Server.
PORT=3000

# Set to your real proxy config (e.g. "1" or "loopback") only when hosted behind a proxy.
TRUST_PROXY=

# Books API (Open Library asks for a contact user-agent).
OPENLIBRARY_USER_AGENT=WasLesen/0.1 (contact: you@example.com)

# Guardrails.
RUN_RATE_LIMIT_PER_HOUR=10
MAX_CONCURRENT_RUNS=3
BOOKS_CONCURRENCY=5

# One-click publish (laptop → hosted app): set PUBLISH_TARGET on the LAPTOP and a local publish
# forwards the run to that hosted app (as well as keeping a local copy).
#
# There are NO passwords anywhere. Organizer vs viewer is decided by whether the machine has a
# `claude` login: with one, the run routes are served and you get the workspace; without one they
# are not registered at all and you get the read-only map (see server.ts). Publishing to a host
# is open by design — the deployment needs no configuration, and a replaced map is one click to
# restore.
PUBLISH_TARGET=

# Semantic map positioning. "local" runs a small model in-process (no key, no cost, offline;
# downloads ~30MB once and adds onnxruntime to the install). "voyage"/"openai" call an API and
# need EMBEDDINGS_API_KEY. "none" disables it — the map uses a deterministic layout. Embeddings
# are best-effort: any error falls back to the deterministic layout, never failing a run.
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_API_KEY=

# Optional: enables the Google Books fallback (covers/pages/existence for titles Open Library
# doesn't know yet — mostly recent releases). A free key from the Google Cloud console (enable
# "Books API"; no billing needed). Anonymous access now has a zero quota, so without a key the
# fallback is skipped and the app is Open-Library-only.
GOOGLE_BOOKS_API_KEY=
